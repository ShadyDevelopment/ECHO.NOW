<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://echonow.app/tizen"
        version="0.3.0"
        viewmodes="maximized">
    <tizen:application id="echonowTV1.ECHONOW" package="echonowTV1" required_version="4.0.0"/>
    <content src="index.html"/>
    <name>ECHO NOW</name>
    <icon src="icon.png"/>
    <description>Discover movies and series with ECHO NOW.</description>
    <feature name="http://tizen.org/feature/screen.size.normal.1920.1080"/>
    <tizen:profile name="tv"/>
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="1920*1080"/>
    <feature name="http://tizen.org/feature/network.internet"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
